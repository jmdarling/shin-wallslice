    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "@fastify/static": "^8.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  }
}
