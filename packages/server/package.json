{
  "name": "@shin-wallslice/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n tsc,node \"tsc --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
